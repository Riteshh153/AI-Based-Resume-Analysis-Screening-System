
# ====================================================================
# HireSmart ATS - Environment Variables Configuration
# Copy this file to .env or set environment variables in your system
# ====================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/hiresmart_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Server Configuration
SERVER_PORT=8085

# JavaMail / SMTP Settings (for applicant status & interview notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# AI Provider Settings (Optional - if empty, HireSmart uses transparent algorithmic ATS screening)
AI_PROVIDER=baseline
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Administrator Credentials (Fixed single admin account)
ADMIN_EMAIL=riteshraushan71@gmail.com
ADMIN_PASSWORD=Ritesh1234@
